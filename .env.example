LLM_GATEWAY_URL=https://api.deepseek.com
LLM_GATEWAY_API_KEY=
LLM_MODEL=deepseek-flash
LLM_PROVIDER=deepseek
GATEWAY_URL=
GATEWAY_API_KEY=
DEEPSEEK_API_KEY=

# Default model: DeepSeek (LLM_PROVIDER=deepseek, LLM_GATEWAY_URL=https://api.deepseek.com,
# LLM_MODEL=deepseek-flash) with DEEPSEEK_API_KEY or LLM_GATEWAY_API_KEY.
# Optional Claude model: GATEWAY_URL and GATEWAY_API_KEY of a hosted /api/chat gateway.
# Labels and model IDs are server-owned in packages/providers/catalog.py.
# Never reuse one provider's credential for another.

# Runtime roles must not own schemas. Local helper writes these to .runtime/local.env.
DATABASE_URL=
FACTORY_DATABASE_URL=
MIGRATION_DATABASE_URL=
PUBLIC_ORIGIN=http://127.0.0.1:5173
ENVIRONMENT=local

# Real SMTP requires explicit permission and an authorized recipient list (or legacy single address).
SMTP_MODE=disabled
SMTP_TIMEOUT_SECONDS=10
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
TEST_EMAIL_RECIPIENT=
# A nonempty list replaces the legacy single-address gate; it never redirects task recipients.
REAL_EMAIL_ALLOWLIST=
ALLOW_REAL_EMAIL=false

# For a trusted LAN demo only, use the host LAN IPv4 address in both this binding and PUBLIC_ORIGIN.
WEB_BIND_ADDRESS=127.0.0.1

FACTORY_API_URL=http://127.0.0.1:8001
FACTORY_API_TOKEN=
FACTORY_EXECUTION_TOKEN=
FACTORY_CONTROL_TOKEN=
